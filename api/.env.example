# ─── Application ──────────────────────────────────────────────────────────
# development | production
APP_ENV=development
# true shows error details in responses; MUST be false in production
APP_DEBUG=true
# Base URL this API is served from (informational; no trailing slash)
APP_URL=http://localhost:8000

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# Include your Netlify dev URL and your local frontend dev URL.
# For production, replace with https://nexumglobal.solutions (or the live domain).
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────
# Use the connection string from your existing Atlas cluster:
#   Project:  nexum
#   Cluster:  webdevelopment
#   User:     areebaweb  (readWrite on nexum_development)
#
# Open Atlas → Clusters → Connect → Drivers → PHP (version 1.17 or later),
# copy the URI, replace <password> with the real one, and append the database
# name so the driver always picks the right DB. Example shape:
#
#   mongodb+srv://areebaweb:<password>@webdevelopment.xxxxx.mongodb.net/nexum_development?retryWrites=true&w=majority&appName=webdevelopment
#
# Treat this value as a password — never commit, never paste in chat.
MONGODB_URI=

# Default database the app reads/writes from.
MONGODB_DB=nexum_development

# ─── Rate limiting (Phase 2) ──────────────────────────────────────────────
# Per-IP sliding window for POST /api/contact. Optional — safe defaults are
# applied in code when unset (5 attempts / 600s). Lower window for stricter
# limits, raise it for noisy clients. Both must be positive integers.
RATE_LIMIT_MAX_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=600

# ─── Trusted proxies (Phase 2) ────────────────────────────────────────────
# PENDING: fill in once Nexum hosting details are finalized.
#
# If this API sits behind a reverse proxy (cPanel's nginx, Cloudflare, a
# load balancer, …), list the proxy IPs here as a comma-separated string.
# Only when REMOTE_ADDR matches one of these do we trust the leftmost IP
# in X-Forwarded-For as the real client. Leaving it empty means we use
# REMOTE_ADDR directly — safer default, but may lump all submissions
# under the proxy's single IP for rate-limiting purposes.
#
# Do NOT guess the proxy IP. Obtain the real value from the hosting
# provider's documentation or by observing REMOTE_ADDR on a test
# request from a known-external client.
TRUSTED_PROXIES=
